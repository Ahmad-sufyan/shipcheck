{
  "name": "shipcheck",
  "version": "0.1.0",
  "description": "Deterministic security auditor for Next.js (App Router) + Supabase apps deployed on Vercel or Cloudflare.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shipcheck": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shipcheck": "tsx src/cli.ts"
  },
  "keywords": [
    "security",
    "audit",
    "nextjs",
    "supabase",
    "static-analysis"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "smol-toml": "^1.9.1",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "execa": "^10.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
